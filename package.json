    "play": "pnpm --filter pgretrieve build && pnpm --filter playground play"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.27.0"
}
